---
// Extends Starlight's default SiteTitle (logo + wordmark) with a horizontal
// top-nav, matching the tcgt.help help-center header. Wrapping the default
// keeps it forward-compatible across Starlight updates.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const nav = [
  { label: 'Guides', href: '/' },
  { label: 'Order Management', href: '/order-management/importing-orders/' },
  { label: 'Inventory', href: '/managing-locations/' },
  { label: 'Integrations', href: '/easypost/' },
  { label: 'Utilities', href: '/bridge/' },
  { label: 'FAQ', href: '/faq/' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<div class="tcg-brandnav">
  <Default {...Astro.props}><slot /></Default>
  <nav class="top-nav" aria-label="Primary">
    {nav.map((i) => (
      <a href={i.href} class={isActive(i.href) ? 'active' : ''}>{i.label}</a>
    ))}
  </nav>
</div>
