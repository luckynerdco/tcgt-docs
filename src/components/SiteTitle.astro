---
// Extends Starlight's default SiteTitle (logo + wordmark) with a horizontal
// top-nav mapping to the five guide categories.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const nav = [
  { label: 'Getting Started', href: '/getting-started/overview/', match: '/getting-started' },
  { label: 'Order Management', href: '/order-management/importing-orders/', match: '/order-management' },
  { label: 'Printing & Shipping', href: '/printing-shipping/printing/', match: '/printing-shipping' },
  { label: 'Inventory', href: '/inventory-management/adding-stock/', match: '/inventory-management' },
  { label: 'Utilities & More', href: '/utilities/audits/', match: '/utilities' },
  { label: 'FAQ', href: '/faq/', match: '/faq' },
  { label: 'Contribute', href: '/contribute/overview/', match: '/contribute' },
];

const current = Astro.url.pathname;
const isActive = (m: string) => current.startsWith(m);
---

<div class="tcg-brandnav">
  <Default {...Astro.props}><slot /></Default>
  <nav class="top-nav" aria-label="Primary">
    {nav.map((i) => (
      <a href={i.href} class={isActive(i.match) ? 'active' : ''}>{i.label}</a>
    ))}
  </nav>
</div>
